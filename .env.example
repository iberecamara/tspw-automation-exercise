# =============================================================================
# .env.example
# Copy this file to `.env` (and/or `.env.<APPLICATION_ENVIRONMENT>`) and adjust
# values as needed. All variables are validated at startup via Joi in
# src/configs/environment.config.ts — invalid values will throw on launch.
# =============================================================================


# -----------------------------------------------------------------------------
# Playwright variables
# -----------------------------------------------------------------------------

# Number of parallel Playwright workers.
# Type: positive integer | Default: 1
WORKERS=2

# Number of times to retry a failing test before marking it as failed.
# Type: positive integer | Default: 0
RETRIES=0

# Whether to run browsers in headless mode.
# Type: boolean (true/false) | Default: true
HEADLESS=true

# Slows down Playwright operations by the specified amount of milliseconds.
# Useful for debugging/watching tests run in headed mode.
# Type: positive integer (ms) | Default: 0
SLOWMO=0

# Browser viewport height, in pixels. Must be set together with VIEWPORT_WIDTH
# to take effect; if either is unset, Playwright's default viewport is used.
# Type: positive integer | Default: null (uses Playwright's default)
VIEWPORT_HEIGHT=

# Browser viewport width, in pixels. Must be set together with VIEWPORT_HEIGHT
# to take effect; if either is unset, Playwright's default viewport is used.
# Type: positive integer | Default: null (uses Playwright's default)
VIEWPORT_WIDTH=

# Which visual-regression baseline set to read from/write to. Normally left blank —
# it's auto-detected (GitHub Actions sets GITHUB_ACTIONS=true itself; the Docker image
# sets RUNNING_IN_DOCKER=true) so baselines are picked correctly with no setup. Only set
# this to force a specific baseline set, e.g. while debugging locally.
# Type: enum | Values: local, docker, github | Default: auto-detected
SNAPSHOT_ENV=


# -----------------------------------------------------------------------------
# Application variables
# -----------------------------------------------------------------------------

# Human-readable name of the application under test (used in reporting/logs).
# Type: string | Required
APPLICATION=Automation Exercise

# Which environment this run targets. Also determines which additional
# .env.<APPLICATION_ENVIRONMENT> file gets loaded alongside .env.
# Type: enum | Values: local, dev, qa, stg, uat, prd | Default: dev
APPLICATION_ENVIRONMENT=dev

# Base URL of the application under test.
# Type: string (valid URI) | Required
BASE_URL=https://automationexercise.com


# -----------------------------------------------------------------------------
# Sharding variables
# (typically set by CI when the suite is split across Playwright shards —
# leave blank for local runs)
# -----------------------------------------------------------------------------

# Index of the current shard (e.g. "1" of "1/4").
# Type: string | Default: "" (empty)
SHARD_INDEX=

# Total number of shards the suite is being split across (e.g. "4" of "1/4").
# Type: string | Default: "" (empty)
SHARD_TOTAL=


# -----------------------------------------------------------------------------
# Logger variables
# -----------------------------------------------------------------------------

# Whether logs are also written to the console (in addition to file output).
# Type: boolean (true/false) | Default: false
LOG_CONSOLE=true

# Format used for log output.
# Type: enum | Values: text, json | Default: text
LOG_TYPE=text

# Minimum severity level of messages to log.
# Type: enum | Values: info, debug, warn, error, verbose | Default: info
LOG_LEVEL=verbose

# Timestamp format used in log lines (a valid dayjs/moment-style format string).
# Type: string | Default: "YYYY-MM-DD HH:mm:ss"
LOG_TIMESTAMP_FORMAT=YYYY-MM-DD HH:mm:ss

# Maximum line length before log output wraps/truncates.
# Type: positive integer | Default: 100
LOG_LINE_LENGTH=100


# -----------------------------------------------------------------------------
# Miscellanea
# -----------------------------------------------------------------------------

# Jira board key used to build test tags (e.g. tag "SAMPLE-1" when set to
# "SAMPLE"). Leave blank if not integrating with Jira.
# Type: string | Optional
JIRA_BOARD=SAMPLE

# If set, removes tests with this Allure status from the generated report
# before publishing (useful for hiding e.g. "skipped" tests from a report).
# Type: enum | Values: passed, failed, broken, skipped | Default: "" (keep all)
ALLURE_REPORT_REMOVE_STATUS=
