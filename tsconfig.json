{
    "compilerOptions": {
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "allowJs": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": [
            "node",
            "playwright"
        ],
        "paths": {
            "@apis/*": [
                "./src/apis/*"
            ],
            "@components/*": [
                "./src/pages/components/*"
            ],
            "@configs/*": [
                "./src/configs/*"
            ],
            "@data/*": [
                "./src/data/*"
            ],
            "@exceptions/*": [
                "./src/exceptions/*"
            ],
            "@files/*": [
                "./src/files/*"
            ],
            "@fixtures/*": [
                "./src/fixtures/*"
            ],
            "@locators/*": [
                "./src/pages/locators/*"
            ],
            "@pages/*": [
                "./src/pages/pages/*"
            ],
            "@pages.base/*": [
                "./src/pages/*"
            ],
            "@steps/*": [
                "./src/steps/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/tests/ui/visual/test-cases.visual.spec.ts",
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}